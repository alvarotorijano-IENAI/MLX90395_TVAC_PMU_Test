
{
  // ⚙️ Desactiva el motor de IntelliSense de C++
  "C_Cpp.intelliSenseEngine": "disabled",

  // 🚫 Desactiva el autocompletado de la extensión
  "C_Cpp.autocomplete": "Disabled",

  // 🚫 Desactiva el análisis de código de fondo
  "C_Cpp.errorSquiggles": "Disabled",

  // 💤 Evita que la extensión procese archivos innecesarios
  "C_Cpp.default.includePath": [],
  "C_Cpp.default.defines": [],
  "C_Cpp.default.compilerPath": "",
  "C_Cpp.default.cStandard": "c11",
  "C_Cpp.default.cppStandard": "c++17",

  // ⚠️ Opcional: evita que la extensión intente configurar automáticamente el entorno
  "C_Cpp.default.configurationProvider": null
}
#!/bin/bash

# --- Basic setup ---

# 1. Get the current branch name
BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)

# 2. Commit message file
COMMIT_MSG_FILE=$1

# 3. Skip if we are not on a normal branch (e.g. during a rebase)
if [ "$BRANCH_NAME" = "HEAD" ]; then
  exit 0
fi

# 4. Extract only the ClickUp task ID (format CU-xxxx...)
CU_ID=$(echo "$BRANCH_NAME" | grep -oE 'CU-[a-z0-9]+')

# If no valid ClickUp ID is found, exit without modifying the message
if [ -z "$CU_ID" ]; then
  exit 0
fi

# 5. Skip if the ID is already present in the commit message
if grep -q "^$CU_ID" "$COMMIT_MSG_FILE"; then
  exit 0
fi

# 6. Insert the ClickUp ID at the top of the message, followed by two blank lines
sed -i "1s|^|$CU_ID\n\n\n|" "$COMMIT_MSG_FILE"
